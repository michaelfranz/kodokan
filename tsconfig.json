{
  "compilerOptions": {
    "target": "es5",
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "jsx": "react",
    "noEmit": false,
    "allowJs": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "preserveConstEnums": true,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "lib": ["dom", "es2015", "es2016", "es2017", "es2018"],
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "**/*.js",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx"
  ]
}
